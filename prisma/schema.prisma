// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model CartUpsellSettings {
  id           String  @id @default(cuid())
  shop         String  @unique
  direction    String  @default("ltr") // "ltr" | "rtl"
  sourceType   String  @default("collection") // "collection" | "manual" | "automatic"
  collectionId String? // Shopify collection GID, used when sourceType is "collection"
  productIds   String  @default("[]") // JSON array of Shopify product GIDs, used when sourceType is "manual"
  displayMode  String  @default("list") // "list" | "slider"

  // Design overrides — null means "inherit from the store's theme"
  headingText        String?
  buttonColor        String?
  buttonTextColor    String?
  buttonBorderRadius Int?

  updatedAt DateTime @updatedAt
}

model UpsellEvent {
  id        String   @id @default(cuid())
  shop      String
  type      String // "add_to_cart" | "purchase"
  productId String // numeric Shopify product id, as a string
  quantity  Int      @default(1)
  amount    Float? // line revenue, only set for "purchase" events
  createdAt DateTime @default(now())

  @@index([shop, type, createdAt])
  @@index([shop, productId])
}
