{%- doc -%}
  Cart Upsell — app embed. Enable this once in Theme Editor > App embeds and
  it automatically injects the upsell strip into the cart drawer, with no
  theme code changes needed. It re-injects itself whenever the drawer
  re-renders after a cart change. Settings are configured from the Cart
  Upsell app's admin.
{%- enddoc -%}

<template data-cart-upsell-i18n
  data-cart-upsell-heading="{{ 'cart_upsell.heading' | t | escape }}"
  data-cart-upsell-add="{{ 'cart_upsell.add' | t | escape }}"
  data-cart-upsell-previous="{{ 'cart_upsell.previous' | t | escape }}"
  data-cart-upsell-next="{{ 'cart_upsell.next' | t | escape }}"></template>

{{ 'cart-upsell.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart-upsell.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Cart upsell (auto-inject)",
  "target": "body"
}
{% endschema %}
