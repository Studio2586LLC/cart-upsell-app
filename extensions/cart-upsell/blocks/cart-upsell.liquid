{%- doc -%}
  Cart Upsell — renders configurable upsell products wherever this block is
  placed (e.g. the cart page). Direction, product source, display mode, and
  design are all configured from the Cart Upsell app's admin, not from
  theme/block settings.
{%- enddoc -%}

<div class="cart-upsell" data-cart-upsell
  data-cart-upsell-heading="{{ 'cart_upsell.heading' | t | escape }}"
  data-cart-upsell-add="{{ 'cart_upsell.add' | t | escape }}"
  data-cart-upsell-previous="{{ 'cart_upsell.previous' | t | escape }}"
  data-cart-upsell-next="{{ 'cart_upsell.next' | t | escape }}" hidden></div>

{{ 'cart-upsell.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart-upsell.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Cart upsell",
  "target": "section",
  "settings": []
}
{% endschema %}
